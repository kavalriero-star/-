    {
      "qid": "wuxia.source_unit",
      "step": "W3",
      "order": 20,
      "label": "내공 원천·단위",
      "question": "내공은 어떻게 쌓이고, 그 깊이는 어떤 단위로 헤아리나요?",
      "genres": [
        "wuxia"
      ],
      "required": false,
      "input": "ai",
      "target": {
        "entity": "system",
        "slot": "wuxia",
        "kind": "internal_energy",
        "path": "",
        "merge": "set"
      },
      "depends": [
        "world.rules"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "unit"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "unit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "years"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10
              },
              "years": {
                "type": "integer",
                "minimum": 1,
                "maximum": 600
              }
            }
          }
        }
      },
      "hint": "쌓는 방법 한 줄과 단위 이름·환산 연수. 예: 1갑자=60년.",
      "examples": [
        {
          "title": "단전 축적·갑자",
          "desc": "정통 무협. 수련 연수가 곧 내공이며 갑자로 센다.",
          "value": {
            "source": "심법으로 운기조식하여 단전에 진기를 쌓는다",
            "unit": {
              "name": "갑자",
              "years": 60
            }
          }
        },
        {
          "title": "자연지기 흡수",
          "desc": "도가 계열. 천지의 기를 받아들여 몸에 녹인다.",
          "value": {
            "source": "천지자연의 기를 호흡으로 받아들여 혈맥에 녹인다",
            "unit": {
              "name": "년",
              "years": 1
            }
          }
        },
        {
          "title": "영약·기연 의존",
          "desc": "기연형. 수련보다 영약 한 알이 판을 바꾼다.",
          "value": {
            "source": "수련은 더디고 영약과 기연으로 단번에 공력이 는다",
            "unit": {
              "name": "십년 공력",
              "years": 10
            }
          }
        }
      ]
    },
