{
  "schemaVersion": 1,
  "questions": [
    {
      "qid": "hunter.awaken",
      "step": "W3",
      "order": 20,
      "label": "각성 규칙·대가",
      "question": "누가, 언제, 어떻게 각성하고, 각성에는 어떤 대가가 따르나요?",
      "genres": [
        "hunter"
      ],
      "required": false,
      "input": "ai",
      "target": {
        "entity": "system",
        "slot": "hunter",
        "kind": "awakening",
        "path": "",
        "merge": "set"
      },
      "depends": [
        "world.rules"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "awaken_rule",
          "cost"
        ],
        "properties": {
          "awaken_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "cost": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "hint": "각성 조건과 대가를 한 줄씩. 재각성 가능 여부도 정하면 좋아요.",
      "examples": [
        {
          "title": "첫 게이트 무작위",
          "desc": "대각성형. 첫 게이트가 열린 날 무작위로 깨어났다.",
          "value": {
            "awaken_rule": "첫 게이트가 열린 날 반경 안에 있던 사람 중 1%가 무작위로 각성했다",
            "cost": "각성 직후 사흘간 고열, 이를 못 넘기면 사망"
          }
        },
        {
          "title": "성인 검사 고정",
          "desc": "제도형. 성인이 되면 검사받고 등급이 평생 고정된다.",
          "value": {
            "awaken_rule": "만 18세에 협회 각성 검사를 받고 등급은 평생 고정된다",
            "cost": "미각성 판정자는 사회적 낙인이 찍힌다"
          }
        },
        {
          "title": "죽음 직전 재각성",
          "desc": "역전형. 죽을 고비마다 다시 각성할 수 있다.",
          "value": {
            "awaken_rule": "죽음 직전까지 몰리면 각성하며, 같은 방식으로 재각성이 가능하다",
            "cost": "각성할 때마다 소중한 기억 하나를 잃는다"
          }
        }
      ]
    },
    {
      "qid": "hunter.gate_rule",
      "step": "W3",
      "order": 21,
      "label": "게이트 규칙",
      "question": "게이트는 어떻게 열리고, 방치하면 어떤 일이 벌어지나요?",
      "genres": [
        "hunter"
      ],
      "required": false,
      "input": "ai",
      "target": {
        "entity": "system",
        "slot": "hunter",
        "kind": "awakening",
        "path": "",
        "merge": "set"
      },
      "depends": [
        "world.premise"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_rule"
        ],
        "properties": {
          "gate_rule": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150
          }
        }
      },
      "hint": "열림·등급 판별·공략 기한·브레이크 중 핵심만 적어 주세요.",
      "examples": [
        {
          "title": "던전 브레이크",
          "desc": "기한형. 제때 못 닫으면 몬스터가 밖으로 쏟아진다.",
          "value": {
            "gate_rule": "게이트는 열린 뒤 7일 안에 보스를 잡아야 닫히며, 넘기면 던전 브레이크로 몬스터가 도시로 쏟아진다"
          }
        },
        {
          "title": "색으로 등급 표시",
          "desc": "정보형. 입구 색으로 위험도를 미리 알 수 있다.",
          "value": {
            "gate_rule": "입구 빛깔로 등급이 드러나고, 게이트 등급보다 한 등급 이상 낮은 헌터는 입장할 수 없다"
          }
        },
        {
          "title": "닫히는 탑",
          "desc": "탑형. 매일 한 층씩 열리고 막지 못하면 도시가 먹힌다.",
          "value": {
            "gate_rule": "서울 한복판의 탑이 매일 자정 한 층씩 열리고, 하루 안에 층을 돌파하지 못하면 구 하나가 탑에 흡수된다"
          }
        }
      ]
    },
