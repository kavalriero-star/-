      "depends": [
        "world.premise"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "era"
        ],
        "properties": {
          "era": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "year",
              "calendar",
              "label"
