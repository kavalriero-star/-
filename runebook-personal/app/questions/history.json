        "history"
      ],
      "required": false,
      "input": "ai",
      "target": {
        "entity": "system",
        "slot": "history",
        "kind": "history_anchor",
        "path": "",
        "merge": "set"
      },
      "depends": [
        "history.era"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_policy",
          "divergence_point"
        ],
        "properties": {
          "fact_policy": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "divergence_point": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "hint": "허구를 넣는 원칙 한 줄, 역사가 갈라지는 지점 한 줄(없으면 없음).",
      "examples": [
        {
          "title": "기록의 빈틈만",
          "desc": "정사 유지형. 실록 기록은 건드리지 않는다.",
          "value": {
            "fact_policy": "실록에 남은 사건과 날짜는 바꾸지 않고 기록의 빈틈에만 허구를 넣는다",
            "divergence_point": "없음, 정사의 흐름을 그대로 따른다"
          }
        },
        {
          "title": "부산진의 분기",
          "desc": "대체역사형. 한 사건을 바꾸고 이후를 새로 쓴다.",
          "value": {
            "fact_policy": "분기점 이전은 사실대로, 이후는 인과에 따라 새로 쓴다",
            "divergence_point": "1592년 4월 부산진 전투 전에 왜군 상륙 정보가 조정에 닿는다"
          }
        },
        {
          "title": "감춰진 비사",
          "desc": "비밀 역사형. 겉 역사는 같고 이면에 초자연이 있다.",
          "value": {
            "fact_policy": "드러난 역사는 그대로 두고 초자연 요소는 기록되지 않은 비사로 숨긴다",
            "divergence_point": "훈민정음 창제 과정에 잡귀를 막는 비밀 문자가 함께 만들어진다"
          }
        }
      ]
