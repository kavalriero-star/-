{
  "schemaVersion": 1,
  "questions": [
    {
      "qid": "mix.system_relation",
      "step": "W3",
      "order": 30,
      "label": "체계 관계",
      "question": "섞인 장르의 힘의 체계들은 서로 어떤 관계인가요?",
      "genres": [
        "mix"
      ],
      "required": false,
      "input": "ai",
      "target": {
        "entity": "work",
        "slot": null,
        "kind": null,
        "path": "mix_policy",
        "merge": "set"
      },
      "depends": [
        "world.rules"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system_relation"
        ],
        "properties": {
          "system_relation": {
            "type": "string",
            "enum": [
              "replace",
              "layer",
              "parallel",
              "translate"
            ]
          }
        }
      },
      "hint": "대체(replace)·겹침(layer)·병렬(parallel)·환산(translate) 중 하나.",
      "examples": [
        {
          "title": "현대 무림: 환산",
          "desc": "헌터+무협. 게이트 안에선 내공이 마력으로 환산된다.",
          "value": {
            "system_relation": "translate"
          }
        },
        {
          "title": "사극 판타지: 겹침",
          "desc": "역사+판타지. 신분제 위에 숨은 술법 체계가 겹친다.",
          "value": {
            "system_relation": "layer"
          }
        },
        {
          "title": "빙의: 대체",
          "desc": "소설 속 빙의. 원래 능력은 사라지고 그 세계 체계로 바뀐다.",
          "value": {
            "system_relation": "replace"
          }
        }
      ]
    },
    {
      "qid": "mix.special_rules",
      "step": "W3",
      "order": 31,
      "label": "조합 특수 규칙",
      "question": "회귀 횟수, 시간 흐름비, 편도·왕복처럼 이 조합만의 규칙이 있나요?",
      "genres": [
        "mix"
      ],
      "required": false,
      "input": "ai",
      "target": {
        "entity": "work",
        "slot": null,
        "kind": null,
        "path": "mix_policy.ext",
        "merge": "set"
      },
      "depends": [
        "mix.system_relation"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rules"
        ],
        "properties": {
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        }
      },
      "hint": "숫자로 정해 두면 나중에 모순이 안 생겨요. 1~5개.",
      "examples": [
        {
          "title": "현대 무림: 왕복 통로",
          "desc": "게이트로 두 세계를 오간다. 시간 흐름이 다르다.",
          "value": {
            "rules": [
              "게이트로 무림과 현대를 왕복할 수 있다",
              "시간 흐름비는 무림 10일당 현대 1일",
              "무림에서 얻은 물건은 하나만 가지고 나올 수 있다"
            ]
          }
        },
        {
          "title": "사극 판타지: 편도 전생",
          "desc": "현대인이 조선에 떨어졌고 돌아갈 수 없다.",
          "value": {
            "rules": [
              "조선으로의 이동은 편도, 돌아갈 방법은 없다",
              "현대 지식은 기억나지만 물건은 하나도 없다"
            ]
          }
        },
        {
          "title": "회귀: 세 번의 기회",
          "desc": "죽으면 과거로. 횟수가 정해져 긴장이 생긴다.",
          "value": {
            "rules": [
              "회귀는 총 3번, 죽을 때만 발동한다",
              "회귀하면 10년 전 같은 날 아침으로 돌아간다",
              "회귀 기억은 주인공만 유지한다"
            ]
          }
        }
      ]
    },
