    {
      "qid": "fantasy.source_cost",
      "step": "W3",
      "order": 20,
      "label": "마법의 원천·대가",
      "question": "이 세계의 마법은 어디서 힘을 끌어오고, 쓰는 사람은 무엇을 치르나요?",
      "genres": [
        "fantasy"
      ],
      "required": false,
      "input": "ai",
      "target": {
        "entity": "system",
        "slot": "fantasy",
        "kind": "magic",
        "path": "",
        "merge": "set"
      },
      "depends": [
        "world.rules"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "cost"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "cost": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        }
      },
      "hint": "원천 한 줄, 대가 한 줄이면 충분해요. 대가가 클수록 긴장이 생겨요.",
      "examples": [
        {
          "title": "대기 마나·서클",
          "desc": "정통 판타지형. 대기의 마나를 몸속 서클에 쌓아 쓴다.",
          "value": {
            "source": "대기 중 마나를 호흡으로 받아들여 심장 주위 서클에 쌓는다",
            "cost": "서클 용량을 넘겨 쓰면 마나 역류로 서클이 깨진다"
          }
        },
        {
          "title": "신과의 계약",
          "desc": "신관형. 힘은 빌린 것이라 계율을 어기면 회수된다.",
          "value": {
            "source": "신과 맺은 계약으로 신성력을 빌려 쓴다",
            "cost": "쓸수록 신앙을 증명해야 하고 계율을 어기면 힘을 잃는다"
          }
        },
        {
          "title": "생명·기억 연소",
          "desc": "어두운 판타지형. 마법이 곧 자기 소모다.",
          "value": {
            "source": "시전자 자신의 생명력과 기억을 불쏘시개로 태운다",
            "cost": "쓸 때마다 수명이 줄고 기억 한 조각이 사라진다"
          }
        }
      ]
    },
    {
      "qid": "fantasy.limits",
      "step": "W3",
      "order": 21,
      "label": "마법의 한계",
      "question": "마법으로도 절대 할 수 없는 일은 무엇인가요?",
      "genres": [
        "fantasy"
      ],
      "required": false,
      "input": "ai",
      "target": {
        "entity": "system",
        "slot": "fantasy",
        "kind": "magic",
        "path": "",
        "merge": "append"
      },
      "depends": [
        "fantasy.source_cost"
      ],
      "value_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "limits"
        ],
        "properties": {
          "limits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          }
        }
      },
      "hint": "할 수 없는 일 1~5개. 한계가 분명해야 주인공의 꾀가 빛나요.",
      "examples": [
        {
          "title": "생사·시간 불가침",
          "desc": "가장 흔한 한계. 죽음과 시간은 건드리지 못한다.",
          "value": {
            "limits": [
              "죽은 자는 되살릴 수 없다",
              "시간은 되돌리거나 멈출 수 없다"
            ]
          }
        },
        {
          "title": "물리적 약점",
          "desc": "철과 소리에 묶인 마법. 전투 전술이 생긴다.",
          "value": {
            "limits": [
              "차가운 철에 닿으면 마법이 흩어진다",
              "주문은 반드시 소리 내어 외워야 한다",
              "물 위에서는 시전이 불안정하다"
            ]
          }
        },
        {
          "title": "속성 하나만",
          "desc": "재능이 속성 하나에 고정된다. 상성 싸움이 중심.",
          "value": {
            "limits": [
              "한 사람은 평생 한 속성만 다룰 수 있다",
              "두 주문을 동시에 유지할 수 없다"
            ]
          }
        }
      ]
    },
